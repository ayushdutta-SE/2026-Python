    "if metric=='L' or metric =='l':\n",
    "  print(float(weight)*0.45)\n",
    "elif metric =='K' or metric=='k':\n",
    "  print(float(weight)*2.20)\n",
    "else:\n",
    "  print('Wrong input')"
