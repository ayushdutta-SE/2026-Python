   "source": [
    "### Find the second largest number in a list of integers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "5fa7945e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "56\n"
     ]
    }
   ],
   "source": [
    "numbers=[45,56,23,1,20,99]     #2nd max-56\n",
    "\n",
    "max=0\n",
    "second_max=0\n",
    "for item in numbers:\n",
    "  if max<item:\n",
    "    max=item\n",
    "\n",
    "for item in numbers:\n",
    "  if second_max<item and item<max:\n",
    "    second_max=item\n",
    "print(second_max)"
   ]
  }
